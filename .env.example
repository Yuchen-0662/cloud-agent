# 复制为 .env 后填入真实值；.env 不会被提交
# OpenAI 兼容的模型服务（Chat Completions，需支持 tools/function calling）
MODEL_API_KEY=sk-xxx
MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
MODEL_NAME=your-model-name

# 浏览器访问端口（宿主机映射）
HOST_PORT=8787

# 可选：单条 shell 命令超时秒数（默认 120）
# CMD_TIMEOUT_SECONDS=120
# 可选：单轮最大工具调用轮数（默认 32）
# AGENT_MAX_STEPS=32
